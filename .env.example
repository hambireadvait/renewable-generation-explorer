# Copy to .env and edit. .env is git-ignored. No variable is required for local use:
# all default providers (NASA POWER, Open-Meteo free tier) need no API key.

# Server
HOST=127.0.0.1
PORT=8000

# On-disk cache of raw provider responses
CACHE_DIR=.cache
CACHE_TTL_HISTORICAL_S=2592000   # 30 days
CACHE_TTL_FORECAST_S=3600        # 1 hour
CACHE_TTL_GEOCODE_S=604800       # 7 days

# Outbound HTTP
HTTP_TIMEOUT_S=60
# Sent as User-Agent so providers can contact you; put a real contact for heavy use.
HTTP_USER_AGENT=renewable-feasibility-explorer/0.1 (local)

# Open-Meteo: free tier is NON-COMMERCIAL only. For commercial use buy a plan and set the key;
# the app then switches to the customer-* hosts automatically.
OPEN_METEO_API_KEY=

# Override base URLs (e.g. self-hosted Open-Meteo) — optional
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal/hourly/point
OPEN_METEO_FORECAST_URL=
OPEN_METEO_ARCHIVE_URL=
OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search

# Set to 1 to disable all outbound calls (only demo provider works) — useful offline/CI
OFFLINE_MODE=0
